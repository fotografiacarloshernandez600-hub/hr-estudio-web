---
import { createClient } from "@sanity/client";

const client = createClient({
  projectId: "6df459fs",
  dataset: "production",
  useCdn: false, 
  apiVersion: "2024-02-21",
});

const ajustes = await client.fetch(`*[_type == "ajustes"][0]{ 
    "logo": logo.asset->url, 
    "fondos": imagenesHero[].asset->url,
    "urlAntes": fotoAntes.asset->url,
    "urlDespues": fotoDespues.asset->url
}`);

const servicios = await client.fetch(`*[_type == "servicio" && defined(slug.current)]{ nombre, "slug": slug.current, descripcionBreve, "urlFondo": imagenFondo.asset->url }`);
const fotos = await client.fetch(`*[_type == "sesion"]{ titulo, municipio, "url": portada.asset->url }`);

const fondoHero = ajustes?.fondos?.[0] || ""; 

const fotoAntes = ajustes?.urlAntes || "https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=1200"; 
const fotoDespues = ajustes?.urlDespues || "https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=1200&sat=-100&con=140";
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HR Estudio | Fotografía Profesional</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style is:global>
        :root { 
            --crema: #FDFCF9; 
            --texto: #2D2D2D; 
            --oro: #C5A059; 
            --borde: #EEECE7;
        }

        #progress-bar { position: fixed; top: 0; left: 0; height: 3px; background: var(--oro); z-index: 100000; width: 0%; transition: width 0.1s linear; }

        @keyframes shimmer { 0% { background-position: -468px 0; } 100% { background-position: 468px 0; } }
        .skeleton { background: #f6f7f8; background-image: linear-gradient(to right, #f6f7f8 0%, #edeef1 20%, #f6f7f8 40%, #f6f7f8 100%); background-size: 800px 100%; animation: shimmer 1.5s linear infinite forwards; }

        body { background: var(--crema); color: var(--texto); font-family: 'Inter', sans-serif; margin: 0; scroll-behavior: smooth; overflow-x: hidden; }

        #custom-cursor { width: 20px; height: 20px; background: var(--oro); border-radius: 50%; position: fixed; pointer-events: none; z-index: 99999; mix-blend-mode: difference; transition: transform 0.05s linear; display: none; }
        @media (pointer: fine) { #custom-cursor { display: block; } }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

        .hero { height: 85vh; background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('${fondoHero}'); background-size: cover; background-position: center; background-attachment: fixed; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: white; padding: 0 20px; }
        .hero-logo { width: 120px; margin-bottom: 20px; filter: drop-shadow(0 2px 10px rgba(0,0,0,0.3)); }
        .parallax-title { font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 10vw, 5.5rem); letter-spacing: 15px; text-transform: uppercase; margin: 0; color: var(--oro); }
        .hero-text { max-width: 800px; margin-top: 20px; line-height: 1.6; font-size: 1.1rem; color: #fff; }

        .comparison-slider { width: 100%; max-width: 900px; margin: 50px auto 100px; position: relative; height: 500px; overflow: hidden; border-radius: 15px; box-shadow: 0 20px 40px rgba(0,0,0,0.15); border: 1px solid var(--borde); cursor: ew-resize; }
        .comparison-slider img { position: absolute; top: 0; left: 0; width: 900px; height: 500px; object-fit: cover; pointer-events: none; }
        .img-after-wrapper { z-index: 2; width: 50%; height: 100%; overflow: hidden; position: absolute; top: 0; left: 0; border-right: 3px solid var(--oro); }
        .slider-handle { position: absolute; z-index: 3; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 44px; height: 44px; background: var(--oro); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 0 10px rgba(0,0,0,0.2); pointer-events: none; }

        .section-title { text-align: center; letter-spacing: 10px; margin: 100px 0 50px; text-transform: uppercase; color: var(--oro); }
        .servicios-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .card-servicio { background: white; border-radius: 15px; overflow: hidden; transition: transform 0.1s ease-out, box-shadow 0.3s ease; text-align: center; padding-bottom: 30px; border: 1px solid var(--borde); }
        .card-servicio:hover { box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        .card-servicio img { width: 100%; height: 300px; object-fit: cover; }
        .card-servicio h3 { color: var(--oro); letter-spacing: 2px; }
        
        .btn-view { display: inline-block; margin-top: 20px; padding: 12px 25px; border: 1px solid var(--oro); color: var(--oro); text-decoration: none; letter-spacing: 2px; transition: 0.3s; }
        .btn-view:hover { background: var(--oro); color: white; }

        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; }
        .gallery-grid.art-mode img { filter: grayscale(100%); }
        .gallery-item { aspect-ratio: 1/1; border-radius: 10px; overflow: hidden; cursor: pointer; position: relative; background: #eee; }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; opacity: 0; }
        .gallery-item img.loaded { opacity: 1; }
        
        .gallery-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: 0.3s; }
        .gallery-overlay span { color: white; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; border: 1px solid white; padding: 10px 20px; }
        .gallery-item:hover .gallery-overlay { opacity: 1; }
        .gallery-item:hover img { transform: scale(1.1); }

        .filter-toggle { display: block; margin: 0 auto 40px; background: none; border: 1px solid var(--oro); color: var(--oro); padding: 10px 20px; cursor: pointer; letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem; }

        .contacto-seccion { background: #F9F9F9; padding: 100px 0; border-top: 1px solid var(--borde); }
        .contacto-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 60px; }
        .col-titulo { font-weight: 700; font-size: 1.1rem; margin-bottom: 30px; display: block; letter-spacing: 2px; text-transform: uppercase; color: var(--oro); }
        .mapa-iframe { width: 100%; border-radius: 20px; filter: grayscale(100%); transition: 0.5s; border: 1px solid var(--borde); }
        .mapa-iframe:hover { filter: grayscale(0%); }
        
        .fb-btn { display: flex; align-items: center; gap: 15px; text-decoration: none; color: var(--texto); font-weight: 600; transition: 0.3s; }
        .fb-btn:hover { color: var(--oro); transform: translateX(10px); }

        .reveal { opacity: 0; transform: translateY(30px); transition: 0.6s ease-out; }
        .reveal.active { opacity: 1; transform: translateY(0); }
        
        #modal-simple { display: none; position: fixed; inset: 0; background: rgba(255,255,255,0.98); z-index: 10000; justify-content: center; align-items: center; }
        #modal-img { max-width: 90%; max-height: 85vh; border-radius: 5px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); }
    </style>
</head>
<body>

    <div id="progress-bar"></div>
    <div id="custom-cursor"></div>

    <header class="hero">
        {ajustes?.logo && <img src={ajustes.logo} class="hero-logo" alt="HR Estudio Logo" />}
        <h1 class="parallax-title">HR ESTUDIO</h1>
        <p class="hero-text">
            Somos HR Estudio Fotografía, especialistas en inmortalizar los momentos más importantes de tu vida. 
            Con pasión y profesionalismo capturamos la esencia de cada evento, desde celebraciones familiares 
            hasta proyectos publicitarios y tomas aéreas, cuidando cada detalle con calidad y creatividad.
        </p>
    </header>

    <main class="container">
        <h2 class="section-title reveal">Nuestros Servicios</h2>
        <div class="servicios-grid">
            {servicios.map((s) => (
                <article class="card-servicio reveal tilt-card">
                    <img src={s.urlFondo} alt={s.nombre} />
                    <h3 style="margin: 20px 0 10px; font-family: 'Playfair Display', serif;">{s.nombre}</h3>
                    <p style="padding: 0 20px; font-size: 0.9rem; color: #666;">{s.descripcionBreve}</p>
                    <a href={`/paquetes/${s.slug}`} class="btn-view">VER PAQUETES</a>
                </article>
            ))}
        </div>

        <h2 class="section-title reveal">Edición Profesional</h2>
        <div class="comparison-slider reveal" id="comp-container">
            <img src={fotoAntes} alt="Original" />
            <div class="img-after-wrapper" id="after-wrap">
                <img src={fotoDespues} alt="Editada" />
            </div>
            <div class="slider-handle" id="comp-handle">↔</div>
        </div>

        <h2 class="section-title reveal">Portafolio</h2>
        <button class="filter-toggle" id="btn-filtro">Vista Artística (B&N)</button>
        <div class="gallery-grid" id="main-gallery">
            {fotos.map((f) => (
                <div class="gallery-item reveal skeleton" onclick={`abrirFoto('${f.url}')`}>
                    <img src={f.url} alt={f.titulo} onload="this.classList.add('loaded'); this.parentElement.classList.remove('skeleton')" />
                    <div class="gallery-overlay">
                        <span>{f.municipio}</span>
                    </div>
                </div>
            ))}
        </div>
    </main>

    <section class="contacto-seccion reveal">
        <div class="container">
            <h2 class="section-title" style="margin-top: 0;">Contacto</h2>
            <div class="contacto-grid">
                <div class="contacto-col">
                    <span class="col-titulo">Ubicación</span>
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15163.665715975618!2d-93.2201314!3d18.4079815!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85eed95d3a54b61d%3A0x6b8d3d9d3f1d3e!2sPara%C3%ADso%2C%20Tabasco!5e0!3m2!1ses-419!2smx!4v1708550000000" class="mapa-iframe" height="250" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    <p style="margin-top:20px; line-height: 1.6;">Nos encontramos en <strong>Paraíso, Tabasco</strong>. Ven a visitarnos para descubrir cómo podemos capturar tus momentos más especiales.</p>
                </div>
                <div class="contacto-col">
                    <span class="col-titulo">Sobre Nosotros</span>
                    <p style="font-style:italic; font-size:1.1rem; color:#666; border-left: 3px solid var(--oro); padding-left: 20px;">"Capturamos la esencia de cada evento cuidando cada detalle con calidad y creatividad."</p>
                </div>
                <div class="contacto-col">
                    <span class="col-titulo">Contáctanos</span>
                    <a href="https://wa.me/9333251889" class="fb-btn" style="margin-bottom:25px; font-size:1.1rem; color:var(--oro); border: 1px solid var(--oro); padding: 10px; border-radius: 8px; justify-content: center;">WhatsApp: 933 325 1889</a>
                    <a href="https://www.facebook.com/CARLOSVLOG13" target="_blank" class="fb-btn">
                        <img src="https://cdn-icons-png.flaticon.com/512/124/124010.png" width="24" />
                        <span>Visítanos en Facebook</span>
                    </a>
                </div>
            </div>
            
            <div style="text-align: center; margin-top: 60px; font-size: 0.8rem; color: #999; letter-spacing: 1px; border-top: 1px solid var(--borde); padding-top: 30px;">
                <p>© {new Date().getFullYear()} HR ESTUDIO | PARAÍSO, TABASCO. TODOS LOS DERECHOS RESERVADOS.</p>
            </div>
        </div>
    </section>

    <div id="modal-simple" onclick="cerrarFoto()">
        <img id="modal-img" src="" />
    </div>

    <script is:inline>
        const cursor = document.getElementById('custom-cursor');
        document.addEventListener('mousemove', (e) => {
            cursor.style.left = e.clientX + 'px'; cursor.style.top = e.clientY + 'px';
            cursor.style.transform = `translate(-50%, -50%)`;
        });

        window.addEventListener('scroll', () => {
            const title = document.querySelector('.parallax-title');
            if(title) title.style.transform = `translateY(${window.scrollY * 0.3}px)`;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            document.getElementById('progress-bar').style.width = (window.scrollY / height) * 100 + '%';
        });

        document.querySelectorAll('.tilt-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width - 0.5;
                const y = (e.clientY - rect.top) / rect.height - 0.5;
                card.style.transform = `perspective(1000px) rotateY(${x * 15}deg) rotateX(${y * -15}deg) translateY(-8px)`;
            });
            card.addEventListener('mouseleave', () => card.style.transform = `none`);
        });

        const compContainer = document.getElementById('comp-container');
        const afterWrap = document.getElementById('after-wrap');
        const compHandle = document.getElementById('comp-handle');
        function move(e) {
            let x = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
            let rect = compContainer.getBoundingClientRect();
            let pos = ((x - rect.left) / rect.width) * 100;
            if (pos >= 0 && pos <= 100) {
                afterWrap.style.width = pos + '%';
                compHandle.style.left = pos + '%';
            }
        }
        compContainer.addEventListener('mousemove', move);
        compContainer.addEventListener('touchmove', move);

        document.getElementById('btn-filtro').addEventListener('click', () => {
            document.getElementById('main-gallery').classList.toggle('art-mode');
        });
        function abrirFoto(url) { document.getElementById('modal-img').src = url; document.getElementById('modal-simple').style.display = 'flex'; }
        function cerrarFoto() { document.getElementById('modal-simple').style.display = 'none'; }
        
        function reveal() {
            document.querySelectorAll(".reveal").forEach(r => {
                if (r.getBoundingClientRect().top < window.innerHeight - 50) r.classList.add("active");
            });
        }
        window.addEventListener("scroll", reveal); reveal();
    </script>
</body>
</html>